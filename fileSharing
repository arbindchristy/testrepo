from http.server import ThreadingHTTPServer, BaseHTTPRequestHandler
from urllib.parse import unquote
import os

FOLDER = r"C:\IntranetShare"
os.makedirs(FOLDER, exist_ok=True)

PAGE = b"""<html><body>
<h2>File Upload</h2>
<input type="file" id="f">
<button onclick="up()">Upload</button>
<p id="m"></p>
<script>
async function up() {
  var f = document.getElementById("f").files[0];
  if (!f) return;
  var m = document.getElementById("m");
  m.textContent = "Uploading...";
  try {
    var r = await fetch("/upload/" + encodeURIComponent(f.name),
      {method: "POST", body: f});
    m.textContent = await r.text();
  } catch (e) {
    m.textContent = "Upload failed";
  }
}
</script>
</body></html>"""


class H(BaseHTTPRequestHandler):

    def do_GET(self):
        self.send_response(200)
        self.send_header("Content-Type", "text/html")
        self.end_headers()
        self.wfile.write(PAGE)

    def do_POST(self):
        name = os.path.basename(unquote(self.path[8:]))
        size = int(self.headers.get("Content-Length", 0))
        if not name or size <= 0:
            self.send_error(400)
            return
        try:
            with open(os.path.join(FOLDER, name), "xb") as f:
                left = size
                while left:
                    c = self.rfile.read(min(65536, left))
                    if not c:
                        break
                    f.write(c)
                    left -= len(c)
        except FileExistsError:
            self.send_error(409, "File already exists")
            return
        self.send_response(200)
        self.end_headers()
        self.wfile.write(b"Upload successful!")


print("Running on port 8000")
ThreadingHTTPServer(("0.0.0.0", 8000), H).serve_forever()
